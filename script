$ErrorActionPreference = "Stop"

# Configuration
$Url = "https://nv-kompmaster.ru/soft/Miror/Miror.zip"

$DownloadFolder = "$env:USERPROFILE\Downloads"
$Archive = Join-Path $DownloadFolder "Miror.zip"

$UpdateFolder = "C:\updates"
$TempFolder = "C:\ESET_Temp"

$LogFolder = "C:\Scripts\Logs"
$LogFile = Join-Path $LogFolder "ESET-update.log"

# Create required directories
New-Item -ItemType Directory -Path $LogFolder -Force | Out-Null
New-Item -ItemType Directory -Path $DownloadFolder -Force | Out-Null

# Logging function
function Write-Log {
    param([string]$Message)

    $Time = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    $Entry = "[$Time] $Message"

    Add-Content -Path $LogFile -Value $Entry
    Write-Host $Entry
}

try {
    Write-Log "========================================"
    Write-Log "Starting ESET Mirror update"

    # 1. Remove previously downloaded archives
    Write-Log "Removing old archive files"

    Get-ChildItem -Path $DownloadFolder -Filter "Miror*.zip" -File |
        Remove-Item -Force

    # 2. Download the archive
    Write-Log "Starting archive download"

    & curl.exe -L `
        --fail `
        --show-error `
        --connect-timeout 20 `
        --max-time 600 `
        --progress-bar `
        -o $Archive `
        $Url

    if ($LASTEXITCODE -ne 0) {
        throw "Download failed. CURL exit code: $LASTEXITCODE"
    }

    if (!(Test-Path $Archive)) {
        throw "Downloaded archive was not found"
    }

    if ((Get-Item $Archive).Length -lt 1024) {
        throw "Downloaded archive is too small"
    }

    Write-Log "Archive downloaded successfully"

    # 3. Prepare temporary directory
    Write-Log "Preparing temporary directory"

    if (Test-Path $TempFolder) {
        Remove-Item $TempFolder -Recurse -Force
    }

    New-Item -ItemType Directory -Path $TempFolder -Force | Out-Null

    # 4. Extract archive
    Write-Log "Extracting archive"

    Expand-Archive `
        -Path $Archive `
        -DestinationPath $TempFolder `
        -Force

    $Files = @(Get-ChildItem -Path $TempFolder -Recurse -File)

    if ($Files.Count -eq 0) {
        throw "Archive is empty"
    }

    Write-Log "Extracted files: $($Files.Count)"

    # 5. Prepare update directory
    Write-Log "Cleaning update directory"

    New-Item -ItemType Directory -Path $UpdateFolder -Force | Out-Null

    Get-ChildItem -Path $UpdateFolder -Force |
        Remove-Item -Recurse -Force

    # 6. Move extracted files
    Write-Log "Moving files to update directory"

    Get-ChildItem -Path $TempFolder -Force |
        Move-Item -Destination $UpdateFolder -Force

    # 7. Remove temporary files
    Write-Log "Removing temporary files"

    Remove-Item $TempFolder -Recurse -Force
    Remove-Item $Archive -Force

    Write-Log "Archive deleted successfully"
    Write-Log "ESET Mirror update completed successfully"
    Write-Log "========================================"
}
catch {
    Write-Log "ERROR: $($_.Exception.Message)"
    Write-Host $_.ScriptStackTrace
    exit 1
}
